# Copy to .env and fill in. Never commit .env.
# Resend API key with "Sending access" only (not "Full access").
RESEND_API_KEY=
# Your own address: every reservation goes here and nowhere else.
RESERVATION_TO=
# Optional. Without a verified domain, Resend's shared sender only delivers to the account owner.
# RESERVATION_FROM="Café Maria Demo <reservierung@deine-domain.at>"
