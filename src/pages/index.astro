---
// Start page. Hero = the chalkboard standing at the café door (signature element from the design brief).
import BaseLayout from '../layouts/BaseLayout.astro';
import ChalkBoard from '../components/ChalkBoard.astro';
import { site, lunchHours } from '../data/site';
import { getOpeningHours } from '../data/hours';

const closedDays = (await getOpeningHours()).filter((h) => !h.open).map((h) => h.label).join(', ');
---

<BaseLayout title="Café Maria – Wiener Kaffeehaus in Neubau">
  <section class="hero" aria-labelledby="hero-title">
    <ChalkBoard class="board">
      <h1 id="hero-title">{site.name}</h1>
      <p class="slogan">{site.slogan}</p>

      <ul class="offers">
        <li><span>Frühstück</span><span class="leader" aria-hidden="true"></span><span>bis 11:30</span></li>
        <li><span>{lunchHours.label}</span><span class="leader" aria-hidden="true"></span><span>{lunchHours.time}</span></li>
        <li><span>Mehlspeisen</span><span class="leader" aria-hidden="true"></span><span>den ganzen Tag</span></li>
      </ul>
      <p class="closed">Mittagstisch {lunchHours.days}, {closedDays} Ruhetag</p>

      <div class="actions">
        <a class="btn btn-chalk" href="/kontakt#reservierung">Tisch reservieren</a>
        <a class="btn btn-outline" href="/speisekarte">Speisekarte ansehen</a>
      </div>
    </ChalkBoard>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-l) var(--gutter) var(--space-2xl);
  }

  .board {
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-xl) var(--space-l);
    text-align: center;
  }

  h1 {
    font-size: var(--text-display);
    letter-spacing: 0.01em;
    text-shadow: 0 0 1px rgb(238 234 224 / 0.6), 0 0 6px rgb(238 234 224 / 0.15); /* soft chalk edge */
  }

  .slogan {
    margin: var(--space-s) auto 0;
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .offers {
    max-width: 26rem;
    margin: var(--space-xl) auto 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .offers li {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    padding-block: var(--space-2xs);
  }
  .offers li span:last-child { font-variant-numeric: tabular-nums; white-space: nowrap; }

  .closed {
    margin: var(--space-s) auto 0;
    font-size: var(--text-sm);
    opacity: 0.85;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-top: var(--space-xl);
  }
  .btn-chalk { background: var(--color-chalk); color: var(--color-board); }
  .btn-chalk:hover { background: var(--color-gold); }

  @media (min-width: 40rem) {
    .hero { padding-top: var(--space-xl); }
    .board { max-width: 58rem; padding: var(--space-xl); }
    h1 { font-size: clamp(3rem, 1rem + 6vw, 6rem); } /* one line, so the buttons stay above the fold */
  }
</style>
