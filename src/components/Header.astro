---
import { site } from '../data/site';

const links = [
  { href: '/speisekarte', label: 'Speisekarte' },
  { href: '/ueber-uns', label: 'Über uns' },
  { href: '/galerie', label: 'Galerie' },
  { href: '/kontakt', label: 'Kontakt' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
---

<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
<header class="site-header">
  <div class="bar">
    <a class="wordmark" href="/">{site.name}</a>

    <a class="btn btn-primary reserve" href="/kontakt#reservierung">
      <!-- Outer span keeps the space: inline-flex would drop whitespace between separate text items. -->
      <span><span class="reserve-prefix">Tisch </span>reservieren</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menü</span>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <path class="line top" d="M3 7h18" />
        <path class="line mid" d="M3 12h18" />
        <path class="line bot" d="M3 17h18" />
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const setOpen = (open: boolean) => toggle?.setAttribute('aria-expanded', String(open));

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-m);
    top: -10rem;
    z-index: 20;
    padding: var(--space-xs) var(--space-m);
    background: var(--color-mokka);
    color: var(--color-creme-light);
  }
  .skip-link:focus { top: var(--space-m); }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-creme);
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 45%, transparent);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    max-width: var(--content-width);
    min-height: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .wordmark {
    margin-right: auto;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    text-decoration: none;
    white-space: nowrap;
  }

  .reserve { padding-inline: var(--space-m); }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--color-mokka);
    cursor: pointer;
  }
  .line {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: 12px 12px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-toggle[aria-expanded='true'] .top { transform: translateY(5px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .mid { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .bot { transform: translateY(-5px) rotate(-45deg); }

  .site-nav { flex-basis: 100%; }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    padding: 0 0 var(--space-s);
    list-style: none;
  }
  .site-nav a {
    display: inline-block;
    padding-block: var(--space-xs);
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-brass);
    text-decoration-thickness: 2px;
  }

  /* Mobile: with JS the nav becomes a toggled panel; without JS it stays visible as a wrapped row. */
  @media (max-width: 55.99rem) {
    :global(.js) .menu-toggle { display: grid; }
    :global(.js) .site-nav { display: none; }
    :global(.js) .menu-toggle[aria-expanded='true'] + .site-nav { display: block; }
    .site-nav ul { flex-direction: column; }
    .site-nav a { padding-block: var(--space-s); font-size: var(--text-lg); }
  }

  @media (max-width: 23.99rem) {
    .reserve-prefix { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .wordmark { font-size: var(--text-lg); }
  }

  @media (min-width: 56rem) {
    .bar { flex-wrap: nowrap; gap: var(--space-xl); }
    .wordmark { margin-right: 0; }
    .site-nav { flex-basis: auto; margin-right: auto; }
    .site-nav ul { padding: 0; }
    .reserve { order: 3; }
  }
</style>
