---
// Reservation form. Works without JS (server validation via the action); the script only shows the same errors earlier.
import { actions } from 'astro:actions';
import { MAX_GUESTS, SLOT_GROUPS, allSlots, bookingDays, formatDate, formatTime, slotGroup } from '../data/reservation';
import { getOpeningHours } from '../data/hours';

interface Props {
  /** First error message per field, from the server. */
  errors?: Record<string, string | undefined>;
  /** Error that belongs to no single field (rate limit, mail failure). */
  formError?: string;
  /** Values to put back after a failed submit. */
  values?: Record<string, string>;
}

const { errors = {}, formError, values = {} } = Astro.props;
const hours = await getOpeningHours();

// Closed days stay in the row (disabled) so the week keeps its shape.
const part = (options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('de-AT', { ...options, timeZone: 'UTC' });
const [weekday, dayNum, month] = [part({ weekday: 'short' }), part({ day: 'numeric' }), part({ month: 'short' })];
const days = bookingDays(hours).map((d) => {
  const noon = new Date(`${d.date}T12:00:00Z`);
  return { ...d, weekday: weekday.format(noon), day: dayNum.format(noon), month: month.format(noon) };
});

// Every slot of the week; the script disables those outside the chosen day. Without JS the server checks.
const slots = allSlots(hours);
const slotGroups = SLOT_GROUPS.map((label) => ({ label, slots: slots.filter((t) => slotGroup(t) === label) })).filter(
  (g) => g.slots.length > 0,
);

const fields = [
  { name: 'name', label: 'Name', type: 'text', autocomplete: 'name' },
  { name: 'email', label: 'E-Mail', type: 'email', autocomplete: 'email' },
  { name: 'phone', label: 'Telefon', type: 'tel', autocomplete: 'tel', hint: 'Für Rückfragen zu Ihrer Reservierung.' },
  { name: 'date', label: 'Datum', choice: true },
  { name: 'time', label: 'Uhrzeit', choice: true },
  { name: 'guests', label: 'Personen', type: 'number', min: 1, max: MAX_GUESTS, inputmode: 'numeric', hint: `1 bis ${MAX_GUESTS} Personen, größere Gruppen bitte telefonisch.` },
] as const;

const labels: Record<string, string> = { ...Object.fromEntries(fields.map((f) => [f.name, f.label])), note: 'Anmerkung' };
const listed = Object.entries(errors).filter(([, msg]) => msg);
const hasErrors = listed.length > 0 || Boolean(formError);
const describedBy = (name: string, hint?: string) => [hint && `${name}-hint`, `${name}-error`].filter(Boolean).join(' ');
---

<form
  class="reservation"
  method="POST"
  action={`${actions.reserve.queryString}#reservierung`}
  novalidate
  data-reservation-form
  data-hours={JSON.stringify(hours)}
>
  <div class="error-summary" tabindex="-1" hidden={!hasErrors} data-error-summary>
    <h3>Bitte prüfen Sie Ihre Angaben</h3>
    <ul>
      {formError && <li>{formError}</li>}
      {listed.map(([name, msg]) => <li><a href={`#res-${name}`}>{labels[name]}: {msg}</a></li>)}
    </ul>
  </div>

  <div class="grid">
    {fields.map((f) => {
      if ('choice' in f) {
        // Native radios in a radiogroup: arrow keys move between them and skip disabled ones.
        return (
          <fieldset
            id={`res-${f.name}`}
            class:list={['field', 'choice', `field-${f.name}`]}
            role="radiogroup"
            aria-required="true"
            aria-describedby={`${f.name}-error`}
            aria-invalid={errors[f.name] ? 'true' : undefined}
          >
            <legend>{f.label}</legend>
            {f.name === 'date' ? (
              <div class="days">
                {days.map((d) => (
                  <label class="day">
                    <input
                      class="visually-hidden"
                      type="radio"
                      name="date"
                      value={d.date}
                      required
                      checked={values.date === d.date}
                      disabled={d.closed}
                      aria-label={`${formatDate(d.date)}${d.closed ? ', geschlossen' : ''}`}
                    />
                    <span class="day-weekday" aria-hidden="true">{d.weekday}</span>
                    <span class="day-num" aria-hidden="true">{d.day}</span>
                    <span class="day-month" aria-hidden="true">{d.month}</span>
                  </label>
                ))}
              </div>
            ) : (
              slotGroups.map((g) => (
                <div class="slot-group" role="group" aria-labelledby={`slots-${g.label}`}>
                  <p class="slot-label" id={`slots-${g.label}`}>{g.label}</p>
                  <div class="chips">
                    {g.slots.map((t) => (
                      <label class="chip">
                        <input class="visually-hidden" type="radio" name="time" value={t} required checked={values.time === t} />
                        <span>{formatTime(t)}</span>
                        <span class="visually-hidden"> Uhr</span>
                      </label>
                    ))}
                  </div>
                </div>
              ))
            )}
            <p class="field-error" id={`${f.name}-error`}>{errors[f.name]}</p>
          </fieldset>
        );
      }
      const hint = 'hint' in f ? f.hint : undefined;
      return (
        <div class:list={['field', `field-${f.name}`]}>
          <label for={`res-${f.name}`}>{f.label}</label>
          {hint && <p class="hint" id={`${f.name}-hint`}>{hint}</p>}
          <input
            id={`res-${f.name}`}
            name={f.name}
            type={f.type}
            required
            value={values[f.name]}
            autocomplete={'autocomplete' in f ? f.autocomplete : undefined}
            min={'min' in f ? f.min : undefined}
            max={'max' in f ? f.max : undefined}
            inputmode={'inputmode' in f ? f.inputmode : undefined}
            aria-describedby={describedBy(f.name, hint)}
            aria-invalid={errors[f.name] ? 'true' : undefined}
          />
          <p class="field-error" id={`${f.name}-error`}>{errors[f.name]}</p>
        </div>
      );
    })}

    <div class="field field-note">
      <label for="res-note">Anmerkung <span class="optional">(optional)</span></label>
      <textarea
        id="res-note"
        name="note"
        rows="4"
        maxlength="500"
        aria-describedby="note-error"
        aria-invalid={errors.note ? 'true' : undefined}
      >{values.note}</textarea>
      <p class="field-error" id="note-error">{errors.note}</p>
    </div>
  </div>

  <!-- Spam trap: hidden from people and assistive tech, bots tend to fill every field. -->
  <div class="trap" aria-hidden="true">
    <label for="res-website">Website (bitte leer lassen)</label>
    <input id="res-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="startedAt" value={Date.now()} />

  <p class="demo-hint">Demo: Ihre Anfrage geht nur an den Betreiber dieser Beispielseite und wird nicht als echte Reservierung bearbeitet.</p>
  <button class="btn btn-primary" type="submit" data-submit>Reservierung anfragen</button>
</form>

<script>
  import { reservationSchema, checkBooking, slotsFor } from '../data/reservation';
  import type { OpeningHours } from '../data/hours';

  const form = document.querySelector<HTMLFormElement>('[data-reservation-form]');
  const summary = form?.querySelector<HTMLElement>('[data-error-summary]');
  const hours: OpeningHours[] = JSON.parse(form?.dataset.hours ?? '[]');

  // Only the slots of the chosen day stay enabled; a choice that no longer fits is cleared.
  function limitTimes() {
    if (!form) return;
    const date = form.querySelector<HTMLInputElement>('input[name="date"]:checked')?.value;
    const allowed = date ? slotsFor(hours, date) : null;
    for (const chip of form.querySelectorAll<HTMLInputElement>('input[name="time"]')) {
      chip.disabled = allowed !== null && !allowed.includes(chip.value);
      if (chip.disabled) chip.checked = false;
    }
  }
  form?.addEventListener('change', (event) => {
    if (event.target instanceof HTMLInputElement && event.target.name === 'date') limitTimes();
  });
  limitTimes();

  // After a failed server round trip, move focus to the errors so screen readers announce them.
  // Waits for load: the #reservierung fragment scroll runs after module scripts and would reset focus to <body>.
  if (summary && !summary.hidden) addEventListener('load', () => setTimeout(() => summary.focus()));

  function showErrors(messages: Map<string, string>) {
    if (!form || !summary) return;
    for (const el of form.querySelectorAll<HTMLElement>('.field-error')) {
      const name = el.id.replace(/-error$/, '');
      el.textContent = messages.get(name) ?? '';
      // The input itself, or the fieldset for date and time.
      const input = document.getElementById(`res-${name}`);
      if (input) {
        if (messages.has(name)) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
    }
    const list = summary.querySelector('ul');
    if (list) {
      list.replaceChildren(
        ...[...messages].map(([name, msg]) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#res-${name}`;
          a.textContent = `${form.querySelector(`label[for="res-${name}"], #res-${name} > legend`)?.firstChild?.textContent?.trim()}: ${msg}`;
          li.append(a);
          return li;
        }),
      );
    }
    summary.hidden = messages.size === 0;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const result = reservationSchema.safeParse(Object.fromEntries(new FormData(form)));
    const booking = result.success ? checkBooking(hours, result.data.date, result.data.time) : null;
    if (result.success && !booking) {
      const button = form.querySelector<HTMLButtonElement>('[data-submit]');
      if (button) {
        // Prevents a second mail from a double click while the page loads.
        button.disabled = true;
        button.textContent = 'Wird gesendet …';
      }
      form.submit();
      return;
    }
    // First message per field, same as the server shows.
    const messages = new Map<string, string>(booking ? [[booking.path, booking.message]] : []);
    for (const issue of result.error?.issues ?? []) {
      const name = String(issue.path[0]);
      if (!messages.has(name)) messages.set(name, issue.message);
    }
    showErrors(messages);
    summary?.focus();
  });
</script>

<style>
  .reservation { display: grid; gap: var(--space-l); }

  .grid { display: grid; gap: var(--space-m) var(--space-l); }
  .field { display: grid; gap: var(--space-2xs); align-content: start; }

  label { font-weight: 600; }
  .optional, .hint { font-weight: 400; color: var(--color-mokka-soft); }
  .hint { font-size: var(--text-sm); }

  input:not([type='radio']), textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-s);
    border: 2px solid var(--color-mokka-soft);
    border-radius: var(--radius-s);
    background: var(--color-creme-light);
    color: var(--color-mokka);
  }
  textarea { resize: vertical; }
  [aria-invalid='true'] { border-color: var(--color-error); }

  /* Date tiles and time chips: the label is the control, the native radio is visually hidden inside it. */
  .choice { min-width: 0; margin: 0; padding: 0; border: 0; }
  legend { padding: 0; margin-bottom: var(--space-xs); font-weight: 600; }

  .day, .chip {
    position: relative; /* keeps the hidden radio inside, so focus scrolls the tile into view */
    border: 2px solid var(--color-mokka-soft);
    background: var(--color-creme-light);
    color: var(--color-mokka);
    cursor: pointer;
    text-align: center;
  }
  .day:hover, .chip:hover { border-color: var(--color-mokka); }
  .day:has(:checked), .chip:has(:checked) {
    border-color: var(--color-green);
    background: var(--color-green);
    color: var(--color-creme-light);
  }
  .day:has(:focus-visible), .chip:has(:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .day:has(:disabled), .chip:has(:disabled) {
    border-style: dashed;
    border-color: var(--color-mokka-soft);
    background: transparent;
    color: var(--color-mokka-soft);
    text-decoration: line-through;
    cursor: not-allowed;
  }
  .choice[aria-invalid='true'] :is(.day, .chip):not(:has(:disabled)) { border-color: var(--color-error); }

  /* Mobile: one swipeable row. Padding leaves room for the focus ring inside the scroll box. */
  .days {
    display: flex;
    gap: var(--space-xs);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: var(--space-xs) var(--space-2xs);
  }
  .day {
    flex: 0 0 4.25rem;
    scroll-snap-align: start;
    display: grid;
    justify-items: center;
    padding: var(--space-xs) var(--space-2xs);
    border-radius: var(--radius-m);
  }
  .day { font-weight: 400; }
  .day-weekday, .day-month { font-size: var(--text-sm); }
  .day-num { font-family: var(--font-display); font-size: var(--text-xl); line-height: var(--leading-tight); }

  .slot-group + .slot-group { margin-top: var(--space-s); }
  .slot-label { margin-bottom: var(--space-2xs); font-size: var(--text-sm); color: var(--color-mokka-soft); }
  .chips { display: grid; grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr)); gap: var(--space-xs); }
  .chip {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    border-radius: var(--radius-s);
    font-variant-numeric: tabular-nums;
  }

  .field-error { color: var(--color-error); font-size: var(--text-sm); font-weight: 600; }
  .field-error:empty { display: none; }

  .error-summary {
    padding: var(--space-m);
    border-left: 4px solid var(--color-error);
    background: var(--color-creme-light);
  }
  .error-summary[hidden] { display: none; }
  .error-summary h3 { font-size: var(--text-lg); }
  .error-summary ul { margin-top: var(--space-xs); padding-left: var(--space-l); }
  .error-summary a { color: var(--color-error); }

  .trap { position: absolute; left: -100vw; width: 1px; height: 1px; overflow: hidden; }

  .demo-hint { font-size: var(--text-sm); color: var(--color-mokka-soft); }
  .btn { justify-self: start; }
  .btn:disabled { opacity: 0.7; cursor: progress; }

  @media (min-width: 40rem) {
    .grid { grid-template-columns: 1fr 1fr; }
    .field-note, .choice { grid-column: 1 / -1; }
    /* Desktop: both weeks at once, no scrolling or arrow buttons needed. */
    .days { display: grid; grid-template-columns: repeat(7, 1fr); overflow: visible; padding: 0; }
  }
</style>
